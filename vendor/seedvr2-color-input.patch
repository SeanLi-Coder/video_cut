+def _read_process_error(stderr_file, limit: int = 16384) -> str:
+    """Read a bounded stderr tail from a temporary file without pipe deadlocks."""
+    if stderr_file is None:
+        return ""
+    try:
+        stderr_file.flush()
+        stderr_file.seek(0, os.SEEK_END)
+        size = stderr_file.tell()
+        stderr_file.seek(max(0, size - limit))
+        return stderr_file.read().decode('utf-8', errors='replace').strip()
+    except (OSError, ValueError):
+        return ""
+
+
+def _normalize_video_rate(value) -> Tuple[str, float]:
+    """Validate an ffmpeg frame-rate value while preserving an exact rational."""
+    try:
+        rate = Fraction(str(value).strip())
+        fps = float(rate)
+    except (ValueError, ZeroDivisionError, OverflowError) as exc:
+        raise ValueError(f"Invalid input frame rate: {value}") from exc
+    if rate <= 0 or not np.isfinite(fps) or fps > 1000:
+        raise ValueError(f"Invalid input frame rate: {value}")
+    return f'{rate.numerator}/{rate.denominator}', fps
+
+
+def _wait_process_bounded(process, timeout: float, *, terminate_first: bool = False) -> Tuple[int, bool]:
+    """Reap a child process, escalating from terminate to kill after a timeout."""
+    timed_out = False
+    try:
+        if terminate_first and process.poll() is None:
+            try:
+                process.terminate()
+            except (OSError, ProcessLookupError):
+                pass
+        try:
+            return process.wait(timeout=timeout), timed_out
+        except subprocess.TimeoutExpired:
+            timed_out = True
+            if process.poll() is None:
+                try:
+                    process.terminate()
+                except (OSError, ProcessLookupError):
+                    pass
+            try:
+                return process.wait(timeout=5), timed_out
+            except subprocess.TimeoutExpired:
+                if process.poll() is None:
+                    try:
+                        process.kill()
+                    except (OSError, ProcessLookupError):
+                        pass
+                return process.wait(), timed_out
+    except BaseException:
+        if process.poll() is None:
+            try:
+                process.kill()
+            except (OSError, ProcessLookupError):
+                pass
+        try:
+            process.wait(timeout=5)
+        except (subprocess.TimeoutExpired, OSError):
+            pass
+        raise
+
