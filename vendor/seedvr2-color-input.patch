+class FFMPEGFilteredVideoCapture:
+    """Stream color-managed 16-bit RGB frames from ffmpeg without an intermediate file."""
+
+    def __init__(self, path: str, video_filter: str, stream_index: int,
+                 width: int, height: int, fps, total_frames: int):
+        self.width = int(width)
+        self.height = int(height)
+        self.ffmpeg_fps, self.fps = _normalize_video_rate(fps)
+        self.total_frames = max(0, int(total_frames))
+        self.read_until_eof = True
+        self._opened = (
+            os.path.isfile(path) and self.width > 0 and self.height > 0
+            and self.fps > 0
+        )
+        self.path = path
+        self.video_filter = video_filter
+        self.stream_index = max(0, int(stream_index))
+        self.start_frame = 0
+        self.proc = None
+        self.stderr_file = None
+        self.eof = False
+        self.frame_bytes = self.width * self.height * 3 * 2
+
+    def isOpened(self) -> bool:
+        return self._opened and (self.proc is None or self.proc.poll() is None)
+
+    def get(self, prop: int) -> float:
+        values = {
+            cv2.CAP_PROP_FPS: self.fps,
+            cv2.CAP_PROP_FRAME_COUNT: self.total_frames,
+            cv2.CAP_PROP_FRAME_WIDTH: self.width,
+            cv2.CAP_PROP_FRAME_HEIGHT: self.height,
+            cv2.CAP_PROP_POS_FRAMES: self.start_frame,
+        }
+        return float(values.get(prop, 0.0))
+
+    def set(self, prop: int, value: float) -> bool:
+        if prop != cv2.CAP_PROP_POS_FRAMES or self.proc is not None:
+            return False
+        self.start_frame = max(0, int(value))
+        return True
+
+    def _start(self) -> None:
+        filters = []
+        if self.start_frame:
+            filters.append(f'trim=start_frame={self.start_frame}')
+        filters.append(self.video_filter)
+        stderr_file = tempfile.TemporaryFile()
+        try:
+            self.proc = subprocess.Popen(
+                [
+                    'ffmpeg', '-hide_banner', '-loglevel', 'error', '-xerror', '-nostdin',
+                    '-noautorotate', '-i', self.path, '-map', f'0:{self.stream_index}',
+                    '-an', '-sn', '-dn', '-vf', ','.join(filters), '-fps_mode', 'passthrough',
+                    '-f', 'rawvideo', '-pix_fmt', 'bgr48le', 'pipe:1'
+                ],
+                stdin=subprocess.DEVNULL,
+                stdout=subprocess.PIPE,
+                stderr=stderr_file,
+            )
+        except BaseException:
+            stderr_file.close()
+            raise
+        self.stderr_file = stderr_file
+
+    def _read_exactly(self, size: int) -> bytes:
+        chunks = bytearray()
+        while len(chunks) < size:
+            chunk = self.proc.stdout.read(size - len(chunks))
+            if not chunk:
+                break
+            chunks.extend(chunk)
+        return bytes(chunks)
+
+    def read(self):
+        if not self._opened or self.eof:
+            return False, None
+        if self.proc is None:
+            self._start()
+        raw = self._read_exactly(self.frame_bytes)
+        if len(raw) == self.frame_bytes:
+            frame = np.frombuffer(raw, dtype=np.dtype('<u2')).reshape(
+                self.height, self.width, 3
+            )
+            return True, frame
+        process = self.proc
+        stderr_file = self.stderr_file
+        try:
+            if process.stdout:
+                process.stdout.close()
+            returncode, timed_out = _wait_process_bounded(process, 30)
+        finally:
+            stderr = _read_process_error(stderr_file)
+            if stderr_file is not None:
+                stderr_file.close()
+            self.proc = None
+            self.stderr_file = None
+            self.eof = True
+        if timed_out:
+            detail = stderr.splitlines()[-1] if stderr else 'no ffmpeg error output'
+            raise RuntimeError(f'ffmpeg color-managed input timed out at EOF: {detail}')
+        if raw:
+            raise RuntimeError('ffmpeg returned a truncated color-managed frame')
+        if returncode != 0:
+            detail = stderr.splitlines()[-1] if stderr else f'exit code {returncode}'
+            raise RuntimeError(f'ffmpeg color-managed input failed: {detail}')
+        return False, None
+
+    def release(self) -> None:
+        process = self.proc
+        stderr_file = self.stderr_file
+        self.proc = None
+        self.stderr_file = None
+        self._opened = False
+        if process is None:
+            if stderr_file is not None:
+                stderr_file.close()
+            return
+        if process.stdout:
+            try:
+                process.stdout.close()
+            except (OSError, ValueError):
+                pass
+        try:
+            _wait_process_bounded(process, 5, terminate_first=True)
+        finally:
+            if stderr_file is not None:
+                stderr_file.close()
+
